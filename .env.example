# Database Configuration (PostgreSQL 16 + PostGIS 3.4)
POSTGRES_USER=crimemap_admin
POSTGRES_PASSWORD=crimemap_secure_2026
POSTGRES_DB=crimemap_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crimemap_admin:crimemap_secure_2026@localhost:5432/crimemap_db

# Security & Authentication
JWT_SECRET_KEY=crimemap_jwt_secret_key_hackathon_2026_supersecure_32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment Mode
ENVIRONMENT=production

# Frontend Port Configuration
FRONTEND_PORT=3000

# CORS Whitelist (JSON array string)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
